# MongoDB Atlas (misma base que usas en local)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.XXXX.mongodb.net/lalapasteleria?retryWrites=true&w=majority&appName=Cluster0

# Hostinger asigna el puerto automáticamente; no lo cambies salvo que el panel lo pida
PORT=3000

# Seguridad
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Google login en la app de clientes
GOOGLE_CLIENT_ID=

# URL pública con tu dominio (sin barra final)
PUBLIC_URL=https://lalapasteleria.com

# Opcional: ruta al JSON de Firebase Admin para push notifications
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
